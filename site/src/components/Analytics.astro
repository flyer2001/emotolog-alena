---
// Аналитика: Яндекс.Метрика + Google Analytics 4 / Google Ads (gtag).
// ID берутся из env — если не заданы, скрипты не рендерятся.
//
// Настройка: см. site/README.md → "Аналитика".

const YM_ID = import.meta.env.PUBLIC_YM_ID;
const GTAG_ID = import.meta.env.PUBLIC_GTAG_ID;

const ymScript = YM_ID
	? `(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");ym(${YM_ID}, "init", {ssr:true,webvisor:true,trackHash:true,clickmap:true,ecommerce:"dataLayer",accurateTrackBounce:true,trackLinks:true});`
	: '';

const gtagScript = GTAG_ID
	? `window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', '${GTAG_ID}');`
	: '';
---

{
	YM_ID && (
		<>
			<script is:inline set:html={ymScript} />
			<noscript>
				<div>
					<img
						src={`https://mc.yandex.ru/watch/${YM_ID}`}
						style="position:absolute; left:-9999px;"
						alt=""
					/>
				</div>
			</noscript>
		</>
	)
}

{
	GTAG_ID && (
		<>
			<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GTAG_ID}`} />
			<script is:inline set:html={gtagScript} />
		</>
	)
}
