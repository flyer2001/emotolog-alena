---
import { faq } from '../data/faq';
---

<section id="faq" class="px-4 sm:px-6 py-20 bg-[#F5D9C8]/40">
	<div class="max-w-3xl mx-auto space-y-10">
		<div class="text-center space-y-4">
			<p class="uppercase tracking-[0.3em] text-xs text-[#C08574]">FAQ</p>
			<h2 class="text-3xl sm:text-4xl font-serif text-[#6B3A32]">Частые вопросы</h2>
		</div>

		<div class="space-y-3">
			{
				faq.map((item) => (
					<details class="group bg-[#FBEEE4] rounded-2xl border border-[#E8B79C]/40 overflow-hidden">
						<summary class="cursor-pointer px-6 py-4 flex items-center justify-between gap-4 font-serif text-lg text-[#6B3A32] list-none">
							<span>{item.q}</span>
							<span class="text-[#C08574] text-xl group-open:rotate-45 transition-transform">+</span>
						</summary>
						<div class="px-6 pb-5 text-[#8A5148] text-sm leading-relaxed">{item.a}</div>
					</details>
				))
			}
		</div>
	</div>
</section>
