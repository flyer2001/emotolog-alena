---
---

<section class="px-4 sm:px-6 py-14 sm:py-20">
	<div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-10 md:gap-16 items-center">
		<div class="space-y-7 text-center md:text-left order-2 md:order-1">
			<p class="uppercase tracking-[0.3em] text-xs text-[#C08574]">
				Эмотолог · специалист по работе с эмоциями
			</p>

			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif leading-tight text-[#6B3A32]">
				Эмотолог<br />
				<span class="italic text-[#C08574]">Алёна Опанасенко</span>
			</h1>

			<p class="text-lg leading-relaxed text-[#8A5148] max-w-lg md:max-w-none">
				Помогу <strong class="text-[#6B3A32]">понять и&nbsp;прожить ваши чувства</strong> за&nbsp;1&#8209;3
				сессии. Конкретная методика через тело — вместо разговоров про&nbsp;детство.
			</p>

			<div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start pt-2">
				<a
					href="https://t.me/alenoch13"
					data-ym-goal="click_tg_write"
					class="inline-block px-6 py-3 rounded-full bg-[#C08574] text-white font-medium hover:bg-[#A56D5D] transition-colors"
				>
					Бесплатная консультация 15&nbsp;мин
				</a>
				<a
					href="#how"
					class="inline-block px-6 py-3 rounded-full border border-[#C08574] text-[#C08574] font-medium hover:bg-[#C08574] hover:text-white transition-colors"
				>
					Как это работает
				</a>
			</div>

			<div class="pt-1">
				<p class="text-xs uppercase tracking-[0.25em] text-[#8A5148]/80 mb-3">
					Написать напрямую
				</p>
				<div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
					<a
						href="https://t.me/alenoch13"
						data-ym-goal="click_tg_write"
						class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-[#FBEEE4] border border-[#C08574]/40 text-[#6B3A32] font-medium hover:bg-[#F5D9C8] transition-colors"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.64 6.8-1.56 7.36c-.12.52-.44.64-.88.4l-2.44-1.8-1.18 1.14c-.14.14-.26.26-.5.26l.18-2.52 4.6-4.16c.2-.18-.04-.28-.32-.1l-5.68 3.58-2.44-.76c-.52-.16-.54-.52.12-.78l9.52-3.68c.44-.16.82.1.68.86Z"/>
						</svg>
						Telegram
					</a>
					<a
						href="https://vk.com/alena_emotolog"
						data-ym-goal="click_vk"
						class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-[#FBEEE4] border border-[#C08574]/40 text-[#6B3A32] font-medium hover:bg-[#F5D9C8] transition-colors"
					>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M12.86 17.5h1.1s.33-.04.5-.22c.16-.17.15-.48.15-.48s-.02-1.46.66-1.68c.67-.21 1.52 1.4 2.44 2.02.7.47 1.22.37 1.22.37l2.44-.04s1.28-.08.67-1.08c-.05-.08-.35-.74-1.82-2.1-1.53-1.42-1.33-1.19.52-3.66 1.12-1.5 1.57-2.42 1.43-2.81-.13-.38-.96-.28-.96-.28h-2.75s-.2-.03-.36.07c-.15.09-.25.3-.25.3s-.44 1.17-1.03 2.17c-1.23 2.11-1.72 2.22-1.92 2.09-.47-.3-.35-1.22-.35-1.87 0-2.03.3-2.88-.6-3.1-.3-.07-.52-.12-1.28-.13-.98-.01-1.8.01-2.27.24-.31.15-.55.5-.4.52.18.03.6.11.82.42.28.4.27 1.27.27 1.27s.16 2.37-.38 2.67c-.37.2-.88-.21-1.98-2.12-.56-.98-.99-2.06-.99-2.06s-.08-.2-.23-.3c-.18-.13-.44-.17-.44-.17l-2.6.02s-.4.01-.54.18c-.13.15-.01.47-.01.47s2.04 4.78 4.35 7.18c2.12 2.2 4.53 2.06 4.53 2.06Z"/>
						</svg>
						ВКонтакте
					</a>
				</div>
			</div>

			<p class="text-xs text-[#8A5148]/70 pt-2">
				Обучалась у&nbsp;<a
					href="https://ashahov.com"
					rel="noopener"
					class="underline underline-offset-4 hover:text-[#C08574]"
					>Александра Шахова</a
				> · автора метода эмотологии
			</p>
		</div>

		<div class="order-1 md:order-2 flex justify-center">
			<div class="relative">
				<div
					class="absolute inset-0 -m-3 rounded-3xl bg-[#E8B79C]/40 rotate-3"
					aria-hidden="true"
				>
				</div>
				<img
					src="/alena.jpeg"
					alt="Опанасенко Алёна — эмотолог"
					width="480"
					height="600"
					loading="eager"
					fetchpriority="high"
					class="relative rounded-3xl w-64 h-80 sm:w-80 sm:h-96 md:w-full md:h-[520px] object-cover object-top shadow-xl"
				/>
			</div>
		</div>
	</div>
</section>
