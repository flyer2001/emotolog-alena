---
const items = [
	{
		title: 'Не «поговорить» — а метод',
		desc: 'Конкретный алгоритм: тело → эмоция → снятие блока → проживание. Не разговоры про детство.',
	},
	{
		title: 'Результат за 1-3 сессии',
		desc: 'Не годы терапии. Ощущение изменений — уже на первой встрече.',
	},
	{
		title: 'Работа тело + эмоции',
		desc: 'Эмоции живут в теле. Учимся слышать телесные сигналы и переводить их в осознание.',
	},
	{
		title: 'Онлайн из любой точки',
		desc: 'Zoom / Telegram. Не нужно ехать в кабинет — метод одинаково работает.',
	},
];
---

<section class="px-4 sm:px-6 py-20">
	<div class="max-w-5xl mx-auto space-y-12">
		<div class="text-center space-y-4 max-w-2xl mx-auto">
			<p class="uppercase tracking-[0.3em] text-xs text-[#C08574]">Что даёт эмотология</p>
			<h2 class="text-3xl sm:text-4xl font-serif text-[#6B3A32]">Почему это работает</h2>
		</div>

		<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
			{
				items.map((item, i) => (
					<div class="text-center space-y-3">
						<div class="w-14 h-14 mx-auto rounded-full bg-[#E8B79C]/60 flex items-center justify-center font-serif text-lg text-[#6B3A32]">
							{i + 1}
						</div>
						<h3 class="font-serif text-lg text-[#6B3A32]">{item.title}</h3>
						<p class="text-sm text-[#8A5148] leading-relaxed">{item.desc}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
