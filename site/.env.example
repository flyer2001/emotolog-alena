# Аналитика.
# Скопировать в .env и заполнить своими ID.
# Пустые значения = скрипты не подключаются вообще.
#
# PUBLIC_ префикс обязателен для Astro — переменные попадают в клиентский код.

# Яндекс.Метрика: число (пример: 98765432)
# Получить: https://metrika.yandex.ru → создать счётчик → номер счётчика
PUBLIC_YM_ID=

# Google Analytics 4 / Google Ads gtag: G-XXXXXXXXXX или AW-XXXXXXXXXX
# GA4: https://analytics.google.com → Admin → Data Streams → Web → Measurement ID
# Google Ads: https://ads.google.com → Tools → Setup → Google tag
PUBLIC_GTAG_ID=
